# Local development only. Production must use a persistent Supabase/PostgreSQL URL.
DATABASE_URL=sqlite:///./data/prtc.db
JWT_SECRET=change-this-in-production
ENVIRONMENT=development
ACCESS_TOKEN_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional only when you intentionally support a controlled origin pattern.
CORS_ORIGIN_REGEX=
# Google OAuth web client ID from Google Cloud Console. Leave blank to disable Google Sign-In.
GOOGLE_CLIENT_ID=
